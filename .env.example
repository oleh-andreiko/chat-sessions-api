# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://app:change_me@localhost:5433/app

# --- OpenAI ---
OPENAI_API_KEY=

# Model used for new sessions when the request does not name one.
# It must have an entry in app/services/pricing.py, otherwise requests fail.
DEFAULT_MODEL=gpt-4o-mini

# How many past messages are replayed to the model on each request.
MAX_HISTORY_MESSAGES=20

OPENAI_TIMEOUT_SECONDS=30
