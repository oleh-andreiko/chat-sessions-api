# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://app:change_me@localhost:5433/app

# --- LLM provider ---
# Fill in only the one actually used; leave the rest empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
